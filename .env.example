# =============================================================================
# Ceiba Data AI Explorer — Environment Variable Template
# =============================================================================
# Copy this file to `.env.local` and fill in REAL values for local development.
#   cp .env.example .env.local
#
# NEVER commit `.env.local`, `.env.production`, or `.env.staging` — they are
# gitignored. This template contains PLACEHOLDER values only; do not put real
# secrets here. Every variable below is read by the application at runtime
# (grep `process.env.` across app/, lib/, middleware.ts to confirm).
#
# For production, load these from a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, Doppler) rather than a flat file. See SECRET_ROTATION.md.
# =============================================================================

# --- Authentication: Clerk -------------------------------------------------
# Managed auth (SSO, MFA). Get both keys from https://dashboard.clerk.com
# (Configure → API Keys). The publishable key is client-side and safe to expose;
# the secret key is server-side and MUST be kept secret.
# Required — the app (ClerkProvider + middleware) will not boot without these.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# --- LLM: OpenAI -----------------------------------------------------------
# Used by the AI chart-suggestion / query features. Create at
# https://platform.openai.com/api-keys
# NOTE: requires a signed BAA with OpenAI before any PHI-adjacent use.
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# --- Billing: Stripe -------------------------------------------------------
# Server-side secret key for the Stripe SDK (lib/stripe.ts). Get from
# https://dashboard.stripe.com/apikeys — use a TEST key (sk_test_...) locally.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# Signing secret for verifying Stripe webhook events (app/api/billing/webhook).
# Get from the Stripe Dashboard → Developers → Webhooks → your endpoint,
# or from `stripe listen` output during local development.
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# --- Data Warehouse: Trino -------------------------------------------------
# Read-only Trino/Presto connection for querying the clinical data lake
# (lib/trinoClient.ts). Values below are the app's built-in defaults; override
# per environment. No password is used (read-only service account).
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=readonly
# Catalog names selected per data domain.
TRINO_CATALOG_ECLINICS=eclinics
TRINO_CATALOG_TELEHEALTH=telehealth
