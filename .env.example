# =============================================================================
# Ceiba Data AI Explorer — Environment Variable Template
# =============================================================================
# Copy this file to `.env.local` and fill in REAL values for local development.
#   cp .env.example .env.local
#
# NEVER commit `.env.local`, `.env.production`, or `.env.staging` — they are
# gitignored. This template contains PLACEHOLDER values only; do not put real
# secrets here. Every variable below is read by the application at runtime
# (grep `process.env.` across app/, lib/, middleware.ts to confirm).
#
# For production, load these from a secrets manager (AWS Secrets Manager,
# HashiCorp Vault, Doppler) rather than a flat file. See SECRET_ROTATION.md.
# =============================================================================

# --- Authentication: Local RBAC session (interim) --------------------------
# INTERIM local auth (Clerk removed in Phase 1). Sessions are signed httpOnly
# cookies (HMAC-SHA256). SESSION_SECRET is the signing key and MUST be a strong
# random value (min 16 chars) kept secret. Rotating it invalidates all sessions.
#   Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required — the app will not sign/verify sessions without it.
SESSION_SECRET=change_me_to_a_long_random_hex_string

# Password applied to the seeded dev users (created on first run into the
# gitignored data/users.json). Optional — if unset, a DEV-ONLY default is used
# (see lib/authStore.ts DEV_SEED_PASSWORD). Set this in staging/production.
# Seeded accounts (across 2 orgs, for tenant-isolation testing):
#   org-ceiba: admin@ceiba-healthcare.com / analyst@ceiba-healthcare.com / clinician@ceiba-healthcare.com
#   org-demo:  admin@demo-hospital.test   / clinician@demo-hospital.test
AUTH_SEED_PASSWORD=

# --- LLM: OpenAI -----------------------------------------------------------
# Used by the AI chart-suggestion / query features. Create at
# https://platform.openai.com/api-keys
# NOTE: requires a signed BAA with OpenAI before any PHI-adjacent use.
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# AI-egress gate (B5 / N1). Default (unset / anything other than the exact
# string "true") = CLOSED: the AI routes (chart-suggest, narrative, and chat when
# a data context is supplied) refuse to send ANY patient-row-derived data to
# OpenAI and return 422 SCOPE. Set to "true" ONLY after BOTH (a) a signed OpenAI
# BAA and (b) the KVKK cross-border / data-residency basis are in place. Even
# when true, the routes send only a schema + aggregate profile — never raw rows.
OPENAI_BAA_SIGNED=false

# --- Data Warehouse: Trino -------------------------------------------------
# Read-only Trino/Presto connection for querying the clinical data lake
# (lib/trinoClient.ts). Values below are the app's built-in defaults; override
# per environment. No password is used (read-only service account).
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=readonly
# Catalog names selected per data domain.
TRINO_CATALOG_ECLINICS=eclinics
TRINO_CATALOG_TELEHEALTH=telehealth

# --- NL->SQL federation topology: mock + staging DSNs ----------------------
# NL2SQL_ENGINE — selects the runtime federation engine used by BOTH
# /api/sql-generate (EXPLAIN validation) and /api/query (execution). They share
# ONE engine so the dialect they validate/execute against is identical (the P1
# dialect-mismatch fix — see lib/engine/provisioning.ts). Default `duckdb`
# (in-process, ATTACHes the read-only Postgres sources below, cross-DB joins
# native). Set to `trino` to swap in the deferred TrinoEngine stub without a route
# rewrite (SPEC §3.3). Any other value falls back to `duckdb`.
NL2SQL_ENGINE=duckdb

# The DuckDB engine ATTACHes these DSNs READ_ONLY under fixed aliases:
#   MOCK_DSN     -> alias "mock"
#   STAGING_DSN  -> alias "staging"
# In /api/query, the caller's `database` field maps onto one of these aliases
# (validated against an allowlist — no arbitrary identifier reaches the engine).
#
# MOCK_DSN — the local synthetic companion Postgres (docker/mock-postgres,
# Phase P1). NO PHI, deterministic synthetic data that correlates with staging
# via the shared id space (HospitalId/MeasurementTypeId/WardId). Engines connect
# as the GENUINELY read-only role `ceiba_ro`. Bring it up with
# `bash scripts/mock-db-up.sh` (listens on 55433 to avoid the 55432 tunnel).
# This placeholder password matches the local dev role in
# docker/mock-postgres/init/03_readonly_role.sql — it is NOT a secret.
MOCK_DSN=postgresql://ceiba_ro:ceiba_ro_pw@localhost:55433/mockdb

# STAGING_DSN — the read-only staging CeibaHospitalDB reached over the SSH
# tunnel on localhost:55432 (see docs/DATA_SOURCES.md). NEVER commit a real
# value: set it only in .env.local / your secrets manager. Connections MUST be
# read-only (PGOPTIONS='-c default_transaction_read_only=on' + SET SESSION
# CHARACTERISTICS AS TRANSACTION READ ONLY). Example shape only:
#   STAGING_DSN=postgresql://CeibaSa:<secret>@localhost:55432/CeibaHospitalDB
# STAGING_DSN=

# --- Python NL->SQL runtime service (ceiba_nl2sql_service) ------------------
# docs/PYTHON_NL2SQL_SERVICE_PLAN.md Phase 3: the FastAPI service is now
# AVAILABLE + metered behind a runtime flag. The TS /api/sql-generate route
# calls it ONLY when NL2SQL_GENERATE_RUNTIME=python (below); the default is
# 'ts' (unchanged in-process generation). These vars configure BOTH the
# standalone service process AND the TS client that reaches it.
#
# --- Runtime cutover flags (TS routes) ---
# NL2SQL_RUNTIME — UMBRELLA runtime for BOTH generation and query execution:
#   ts      (DEFAULT) — in-process TS runtime for both.
#   python           — Python FastAPI service for both.
# The per-endpoint flags below inherit this umbrella unless individually set.
# PREFER setting ONLY this one flag: running generate on one runtime and query
# on the other reopens the dialect-mismatch window (two engines, two dialect
# defaults). If the two effective runtimes diverge, the routes emit a one-time
# boot WARNING (lib/nl2sqlRuntime.ts warnIfRuntimesDiverge, plan §7.3).
NL2SQL_RUNTIME=ts

# NL2SQL_GENERATE_RUNTIME — OVERRIDE which runtime serves NL->SQL generation
# (transition-only; defaults to NL2SQL_RUNTIME above):
#   ts               — in-process lib/rag generateSql; nothing changes.
#   python           — POST to the Python service /nl2sql/generate (metered).
# Cutover = set to 'python' (flag on → canary org → all). Rollback = set back
# to 'ts' — a single env flip, NO redeploy (plan §5). Requires NL2SQL_SERVICE_URL
# + NL2SQL_SERVICE_TOKEN set when 'python'. Leave UNSET to inherit NL2SQL_RUNTIME.
# NL2SQL_GENERATE_RUNTIME=ts

# NL2SQL_QUERY_RUNTIME — which runtime EXECUTES the guard-passed SQL at /api/query
# (docs/PYTHON_NL2SQL_SERVICE_PLAN.md §5 Phase 4):
#   ts      (DEFAULT) — in-process getQueryEngine().execute; nothing changes.
#   python           — POST to the Python service /nl2sql/execute.
# ALL the TS hardening (auth → rate-limit → body-size → validate → catalog/schema
# allowlist → guardSql RE-GUARD) runs IDENTICALLY on both paths; the guardSql
# re-guard is the execution boundary and always runs in TS BEFORE any dispatch to
# the service (a write/DDL is rejected 422 and never reaches the service). Only the
# execute call moves. Cutover = set to 'python' (flag on → canary → all). Rollback =
# set back to 'ts' — a single env flip, NO redeploy (plan §5). Requires
# NL2SQL_SERVICE_URL + NL2SQL_SERVICE_TOKEN set when 'python'. With the Python
# runtime, generate + execute share ONE memoized engine so dialect stays aligned.
# (Renamed from the plan's earlier draft name NL2SQL_EXECUTE_RUNTIME — the code
# has always used NL2SQL_QUERY_RUNTIME.) Leave UNSET to inherit NL2SQL_RUNTIME.
# NL2SQL_QUERY_RUNTIME=ts

# NL2SQL_SERVICE_TIMEOUT_MS — TS client timeout for the service call (default
# 60000). On timeout the route returns a generic 502 (never a raw error).
# NL2SQL_SERVICE_TIMEOUT_MS=60000

# --- LLM model + pricing (service process; per-query cost metering) ---
# NL2SQL_LLM_MODEL — the driving OpenAI model the service uses for generation
# (default gpt-4o-mini). The per-query `usage` block prices this model's tokens
# from the price table below. (Legacy alias: OPENAI_MODEL.)
NL2SQL_LLM_MODEL=gpt-4o-mini

# NL2SQL_MODEL_PRICES — OPTIONAL JSON override for the USD price table used to
# compute estimatedCostUsd. Prices are USD per 1,000,000 (1M) tokens, per model,
# merged over the built-in defaults (override just one model if you like). The
# built-in defaults (ceiba_nl2sql/generation/pricing.py) carry current list
# prices; override here for a price change without a code deploy. Example:
#   NL2SQL_MODEL_PRICES={"gpt-4o-mini":{"input":0.15,"output":0.60}}
# NL2SQL_MODEL_PRICES=

# NL2SQL_BUNDLE_DIR — path to the artifact bundle directory the service loads
# at startup (same portable-directory model prep produces, NL2SQL_SPEC.md
# §1.1). For local dev against the committed fixture bundle:
#   NL2SQL_BUNDLE_DIR=lib/rag/__tests__/fixtures/bundles/mock-v1
#   NL2SQL_EMBEDDING_MODEL_ID=test-deterministic-hash-v1   (fixture uses the test-fallback embedder)
# NL2SQL_BUNDLE_DIR=
# NL2SQL_EMBEDDING_MODEL_ID=

# NL2SQL_SERVICE_TOKEN — shared internal Bearer token; the service rejects any
# request to a protected route without this EXACT token (constant-time
# compare). A service credential, not a user credential — never a secret a
# browser sees. Generate with e.g. `openssl rand -hex 32`.
# NL2SQL_SERVICE_TOKEN=

# NL2SQL_SERVICE_PORT — port uvicorn binds for the service (default 8088).
NL2SQL_SERVICE_PORT=8088

# NL2SQL_SERVICE_URL — where the TS client (lib/nl2sqlServiceClient.ts) reaches
# this service when NL2SQL_GENERATE_RUNTIME=python. Required for the python
# runtime; ignored for 'ts'.
# NL2SQL_SERVICE_URL=http://127.0.0.1:8088
