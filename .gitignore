# Dependencies
node_modules/
.pnp
.pnp.js

# Python (prep toolchain + shared ceiba_nl2sql library + ceiba_nl2sql_service)
__pycache__/
*.pyc
prep/.venv/
prep/*.egg-info/
ceiba_nl2sql/*.egg-info/
ceiba_nl2sql_service/*.egg-info/
.pytest_cache/

# NL2SQL generated artifact bundles (build output — regenerable via prep toolchain)
artifacts/bundles/

# NL2SQL eval harness (P6): generated synthetic DuckDB files. Default runs write to the
# OS temp dir, never here — this guards any debugging run that passes an explicit dbPath
# under eval/fixtures/ (docs/NL2SQL_PLAN.md §7 "fixtures/ generated synthetic DuckDB
# files (gitignored)"). eval/fixtures/recordedLlm.ts itself IS committed source, not output.
eval/fixtures/*.duckdb
eval/fixtures/generated/

# Next.js
.next/
out/
build/

# Environment — never commit real secrets.
# Ignore ALL .env variants, then explicitly allow the committed template.
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Audit logs (PHI — never commit)
logs/
logs/privacy-requests.log

# Local auth store (data/users.json holds emails + bcrypt password hashes —
# credentials, never commit)
data/

# Persistent app state (PHI — dashboards, saved queries — never commit)
.data/

# QA / audit report outputs (may embed PHI or secrets — never commit)
# Keep the directory itself via a tracked .gitkeep.
.qa-reports/
!.qa-reports/.gitkeep

# Test coverage reports (generated by `npm run test:coverage`)
coverage/

# Playwright
playwright-report/
test-results/
