# Dependencies
node_modules/
.pnp
.pnp.js

# Python (prep toolchain)
__pycache__/
*.pyc
prep/.venv/
prep/*.egg-info/
.pytest_cache/

# NL2SQL generated artifact bundles (build output — regenerable via prep toolchain)
artifacts/bundles/

# Next.js
.next/
out/
build/

# Environment — never commit real secrets.
# Ignore ALL .env variants, then explicitly allow the committed template.
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
.env.staging

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Audit logs (PHI — never commit)
logs/
logs/privacy-requests.log

# Local auth store (data/users.json holds emails + bcrypt password hashes —
# credentials, never commit)
data/

# Persistent app state (PHI — dashboards, saved queries — never commit)
.data/

# QA / audit report outputs (may embed PHI or secrets — never commit)
# Keep the directory itself via a tracked .gitkeep.
.qa-reports/
!.qa-reports/.gitkeep

# Test coverage reports (generated by `npm run test:coverage`)
coverage/

# Playwright
playwright-report/
test-results/
